set.seed(123)  

bootstrap_prcc <- function(X_rank, Y, nboot = 1000) {
  
  n <- nrow(X_rank)
  k <- ncol(X_rank)
  
  prcc_boot <- matrix(NA_real_, nrow = nboot, ncol = k)
  
  for (b in seq_len(nboot)) {
    idx <- sample(seq_len(n), size = n, replace = TRUE)
    Xb  <- X_rank[idx, , drop = FALSE]
    Yb  <- Y[idx]
    
    dat <- cbind(Yb, Xb)
    
    # Use Pearson here because we've *already* rank-transformed
    pc <- suppressWarnings(
      ppcor::pcor(dat, method = "pearson")
    )$estimate
    
    est <- pc[2:(k + 1), 1]
    prcc_boot[b, ] <- est
  }
  
  # Drop any bootstrap draws that ended up with NA (e.g., perfectly collinear resample)
  keep <- apply(!is.na(prcc_boot), 1, all)
  prcc_boot_clean <- prcc_boot[keep, , drop = FALSE]
  
  prcc_mean <- apply(prcc_boot_clean, 2, mean)
  prcc_ci   <- apply(prcc_boot_clean, 2, quantile, probs = c(0.025, 0.975))
  
  list(
    prcc = prcc_mean,
    ci   = prcc_ci,
    boot = prcc_boot_clean
  )
}


