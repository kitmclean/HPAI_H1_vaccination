library(dplyr)
library(purrr)
library(deSolve)
library(ggplot2)
library(scales)
library(furrr)
library(future)

# ------------------------------------------------------------
# 1) Choose target end-of-season coverages and map to nu
#    (using your existing baseline_curve mapping nu -> vax_coverage)
# ------------------------------------------------------------
cov_targets <- c(0.05, 0.10, 0.25, 0.50, 0.60, 0.80)

bc <- baseline_curve %>% arrange(vax_coverage)

nu_targets <- approx(
  x    = bc$vax_coverage,
  y    = bc$nu,
  xout = cov_targets,
  rule = 2
)$y

scenario_map <- tibble(
  cov_target = cov_targets,
  cov_label  = paste0(round(100 * cov_targets), "%"),
  nu         = nu_targets
) %>%
  mutate(cov_label = factor(cov_label, levels = cov_label))

# ------------------------------------------------------------
# 2) Helper: run one parameter set across scenarios, return p_ge1(t)
# ------------------------------------------------------------
run_one_paramset <- function(j, lhs_params_curve, scenario_map, base_params, x0, times) {
  
  # plug LHS parameters into base_params (excluding nu; nu set per scenario)
  params_j <- base_params
  params_j[names(lhs_params_curve[j, ])] <- as.list(lhs_params_curve[j, ])
  
  # run each coverage scenario
  out_list <- lapply(seq_len(nrow(scenario_map)), function(k) {
    
    params_j$nu <- scenario_map$nu[k]
    
    sim <- ode(
      y     = x0,
      times = times,
      func  = SLIR_two_virus_vax,
      parms = params_j
    )
    
    as.data.frame(sim) %>%
      transmute(
        sample_id = j,
        cov_label = scenario_map$cov_label[k],
        time      = time,
        # Poisson approximation for ENTIRE population:
        p_ge1     = 1 - exp(-C_coinfection)
      )
  })
  
  bind_rows(out_list)
}

# ------------------------------------------------------------
# 3) Run across LHS parameter sets in parallel
# ------------------------------------------------------------
plan(multisession)

n_sets <- nrow(lhs_params_curve)  # e.g., 150 in your curve uncertainty section

prob_time_all <- furrr::future_map_dfr(
  seq_len(n_sets),
  run_one_paramset,
  lhs_params_curve = lhs_params_curve,
  scenario_map     = scenario_map,
  base_params      = base_params,
  x0               = x0,
  times            = times,
  .options = furrr::furrr_options(seed = TRUE)
)

# ------------------------------------------------------------
# 4) Summarize uncertainty bands over parameter sets
# ------------------------------------------------------------
prob_time_sum <- prob_time_all %>%
  group_by(cov_label, time) %>%
  summarise(
    p_med = median(p_ge1, na.rm = TRUE),
    p_lo  = quantile(p_ge1, 0.025, na.rm = TRUE),
    p_hi  = quantile(p_ge1, 0.975, na.rm = TRUE),
    .groups = "drop"
  )

# ------------------------------------------------------------
# 5) Plot: median + 95% interval over time, by scenario
# ------------------------------------------------------------
ggplot(prob_time_sum, aes(x = time, y = p_med, group = cov_label)) +
  geom_ribbon(aes(ymin = p_lo, ymax = p_hi), alpha = 0.12) +
  geom_line(linewidth = 1.0) +
  facet_wrap(~ cov_label, ncol = 3) +
  scale_y_continuous(labels = percent_format(accuracy = 1), limits = c(0, 1)) +
  labs(
    x = "Time (days)",
    y = "P(≥1 H1+H5 coinfected worker in population)\n(Poisson approximation)",
    title = "Population risk of at least one H1+H5 coinfection over time",
    subtitle = "Lines show median; shaded areas show 95% interval across parameter sets"
  ) +
  theme_classic(base_size = 12)
