# 5. Vaccination–coinfection relationship (nu sweep)
#    - Sweep nu over a fine grid
#    - Run ODE model in parallel
#    - Compute total coinfections and coverage
#    - Plot coinfection burden vs vaccination coverage
###############################################################################


# Creating a nice figure showing the relationship between nu values (vaccination rate) and cumulative coinfection

# Set up parallel backend
plan(multisession)  

# Define vaccination rate range
nu_vals <- seq(nu_min_lhs, nu_max_lhs, length.out = 200)

# Run simulations in parallel
results <- future_map(nu_vals, function(nu) {
  
  # Clone parameter list and update vaccination rate
  params <- base_params
  params$nu <- nu
  
  # Run ODE model
  vrout <- ode(y = x0, times = times, func = SLIR_two_virus_vax, parms = params)
  
  # Store results as dataframe
  df <- as.data.frame(vrout)
  df$nu <- nu
  return(df)
  
}, .options = furrr_options(seed = TRUE))  # for reproducibility

# Combine into a single data frame
nu_sim_data <- bind_rows(results) %>%
  mutate(vax_coverage = C_Vax / PopSize * 100)

peak_cumulative <- nu_sim_data %>%
  filter(time == 200) 


ggplot(peak_cumulative, aes(x = vax_coverage , y = C_coinfection)) +
  geom_line(color = "green", size = 1.2) +
  labs(
    x = "Vaccination coverage of worker population (%)",
    y = "Total no. coinfected workers during flu season",
    title = "Seasonal Coinfection Burden vs Vaccination Rate"
  ) +
  theme_minimal(base_size = 14) 


