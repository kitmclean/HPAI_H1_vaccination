# 6. Uncertainty around the vaccination–coinfection curve
#    - LHS over key epidemiologic parameters (excluding nu)
#    - For each parameter set, sweep nu over a grid
#    - Summarize median and 95% interval of coinfections vs coverage
#    - Overlay baseline (no-uncertainty) curve
###############################################################################

## 6.1 Choose parameters to vary for the curve --------------------------------

# All parameters to vary *except* nu (which will be swept explicitly)
param_names_curve <- setdiff(param_names, "nu")

# Match min/max in the same order as param_names_curve
param_min_curve <- param_min[match(param_names_curve, param_names)]
param_max_curve <- param_max[match(param_names_curve, param_names)]

## 6.2 Latin Hypercube for curve analysis -------------------------------------

set.seed(1234)  # reproducibility

n_sets <- 150   # number of parameter sets for the curve uncertainty

lhs_raw_curve    <- randomLHS(n_sets, length(param_names_curve))
lhs_params_curve <- matrix(NA_real_, n_sets, length(param_names_curve))

for (i in seq_along(param_names_curve)) {
  lhs_params_curve[, i] <-
    param_min_curve[i] +
    lhs_raw_curve[, i] * (param_max_curve[i] - param_min_curve[i])
}
colnames(lhs_params_curve) <- param_names_curve

## 6.3 Define a grid of nu values to sweep ------------------------------------

# Use the calibrated nu range from your coverage calibration
nu_grid <- seq(nu_min_lhs, nu_max_lhs, length.out = 40)

## 6.4 Run nu sweep for each parameter set (in parallel) ----------------------

plan(multisession)  # parallel backend (furrr / future)

curve_results <- furrr::future_map(
  seq_len(n_sets),
  function(j) {
    
    # Take j-th LHS parameter set and plug into base_params
    params_j <- base_params
    params_j[names(lhs_params_curve[j, ])] <- lhs_params_curve[j, ]
    
    # For this parameter set, sweep nu over the grid
    out_j <- lapply(nu_grid, function(nu_val) {
      
      params_j$nu <- nu_val
      
      sim <- ode(
        y     = x0,
        times = times,
        func  = SLIR_two_virus_vax,
        parms = params_j
        # , method = "vode"  # uncomment for faster stiff solver
      )
      
      df <- as.data.frame(sim)
      
      data.frame(
        sample_id    = j,
        nu           = nu_val,
        vax_coverage = df$C_Vax[nrow(df)] / PopSize,      # final coverage
        coinfection  = df$C_coinfection[nrow(df)]         # final total coinfections
      )
    })
    
    dplyr::bind_rows(out_j)
  },
  .options = furrr::furrr_options(seed = TRUE)  # reproducible parallel RNG
)

# Combine all parameter sets into one data frame
curve_df <- dplyr::bind_rows(curve_results)

## 6.5 Summarize uncertainty across parameter sets ----------------------------

# For each nu, summarize distribution across parameter sets
summary_curve <- curve_df %>%
  dplyr::group_by(nu) %>%
  dplyr::summarise(
    vax_cov_med = median(vax_coverage),
